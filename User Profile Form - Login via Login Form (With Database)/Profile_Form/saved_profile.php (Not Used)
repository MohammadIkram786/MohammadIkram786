<?php
// Database connection details
$servername = "localhost"; // or your database server
$username = "root";        // your database username
$password = "";            // your database password
$dbname = "user_info";   // your database name

// Create connection
$conn = new mysqli($servername, $username, $password, $dbname);

// Check connection
if ($conn->connect_error) {
    die("Connection failed: " . $conn->connect_error);
}

// Get form data
$usrname = $_POST['username'] ?? '';
$passwrd = $_POST['password'] ?? '';

// Check if both fields are provided
if ($usrname && $passwrd) {
    // Prepare SQL query to fetch user data based on username and password
    $sql = "SELECT * FROM registration WHERE username = ? AND password = ?";
    $stmt = $conn->prepare($sql);
    $stmt->bind_param("ss", $usrname, $passwrd); // "ss" means two strings

    // Execute the query
    $stmt->execute();
    $result = $stmt->get_result();

    // Check if user was found
    if ($result->num_rows > 0) {
        // Fetch the user data
        $user = $result->fetch_assoc();

        // Display the user data
        // echo "<h2>User Information</h2>";
        // echo "<p><strong>Username:</strong> " . htmlspecialchars($user['username']) . "</p>";
        // echo "<p><strong>Email:</strong> " . htmlspecialchars($user['email']) . "</p>";
        // echo "<p><strong>Mobile:</strong> " . htmlspecialchars($user['mobile']) . "</p>";
    } else {
        echo "<p>No user found with the provided name and email.</p>";
    }

    // Close the statement
    $stmt->close();
} else {
    echo "<p>Please provide both name and email.</p>";
}

// Close the connection
$conn->close();
?>


